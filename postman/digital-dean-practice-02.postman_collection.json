    {
      "name": "08 Read local benchmark report",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('prepared benchmark report is available', () => pm.response.to.have.status(200));",
              "pm.test('schema_version=1 and 36 results', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.schema_version).to.eql(1);",
              "  pm.expect(body.results).to.have.lengthOf(36);",
              "  pm.expect(body.parameters.warmup).to.eql(10);",
              "  pm.expect(body.parameters.series).to.eql(5);",
              "  pm.expect(body.parameters.operations_per_series).to.eql(100);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/lab/crypto/benchmark-results"
      }
    },
    {
      "name": "09a Practice 1: GET student",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('practice 1 fields kept', () => pm.expect(pm.response.json()).to.have.all.keys('id','full_name','email','group_code','enrollment_year'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/students/{{student_id}}"
      }
    },
