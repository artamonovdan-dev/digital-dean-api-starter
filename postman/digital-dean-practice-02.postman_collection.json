{
  "info": {
    "_postman_id": "dc000002-0000-4000-8000-000000000002",
    "name": "Digital Dean — Practice 02 (variant 1: category)",
    "description": "Виконуйте запити послідовно (Run collection). Дані вигадані. Робота 1: варіант enrollment_year. Робота 2: варіант 1 — поле category (general, academic, administrative). Запит 08 потребує попереднього запуску python -m benchmarks.crypto_benchmark --output-dir results/practice-02. Підміна серверного конверта перевіряється автоматизованими тестами, не HTTP-маршрутом.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "student_id",
      "value": ""
    },
    {
      "key": "other_student_id",
      "value": ""
    },
    {
      "key": "note_id",
      "value": ""
    },
    {
      "key": "note_text",
      "value": "  Навчальна примітка про індивідуальний план  "
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('service is ready', () => pm.expect(pm.response.json()).to.eql({status: 'ok'}));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "02 Create synthetic student",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('student_id', '');",
              "pm.collectionVariables.set('note_id', '');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "pm.test('practice 1 variant field is kept', () => pm.expect(pm.response.json().enrollment_year).to.eql(2024));",
              "if (pm.response.code === 201) pm.collectionVariables.set('student_id', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/students",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Олена Коваль\",\n  \"email\": \"practice02-{{$guid}}@example.com\",\n  \"group_code\": \"КН-31\",\n  \"enrollment_year\": 2024\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "03 Create protected note (category academic)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('student_id')) throw new Error('Create student first');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('note metadata without internal fields', () => {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.id).to.be.a('string');",
              "  pm.expect(body.student_id).to.eql(pm.collectionVariables.get('student_id'));",
              "  pm.expect(body.algorithm).to.eql('AES-256-GCM');",
              "  pm.expect(body.category).to.eql('academic');",
              "  ['text', 'key', 'key_id', 'nonce', 'ciphertext', 'tag'].forEach(field => pm.expect(body).not.to.have.property(field));",
              "});",
              "if (pm.response.code === 201) pm.collectionVariables.set('note_id', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/students/{{student_id}}/secure-notes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"{{note_text}}\",\n  \"category\": \"academic\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "04 Read verified note",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('note_id')) throw new Error('Create note first');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('verified text is preserved exactly', () => {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.id).to.eql(pm.collectionVariables.get('note_id'));",
              "  pm.expect(body.student_id).to.eql(pm.collectionVariables.get('student_id'));",
              "  pm.expect(body.text).to.eql(pm.collectionVariables.get('note_text'));",
              "  pm.expect(body.category).to.eql('academic');",
              "  ['key', 'key_id', 'nonce', 'ciphertext', 'tag'].forEach(field => pm.expect(body).not.to.have.property(field));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/students/{{student_id}}/secure-notes/{{note_id}}"
      }
    },
    {
      "name": "05 Reject blank note",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('blank note is rejected', () => pm.response.to.have.status(422));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/students/{{student_id}}/secure-notes",
        "body": {
          "mode": "raw",
          "raw": "{\"text\": \"   \"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "06 Reject client key field",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('unknown input field is rejected', () => pm.response.to.have.status(422));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/students/{{student_id}}/secure-notes",
        "body": {
          "mode": "raw",
          "raw": "{\"text\": \"Вигадана примітка\", \"key\": \"not-a-real-key\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
