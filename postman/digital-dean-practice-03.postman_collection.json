                  "if (pm.collectionVariables.get(\"variant\") !== \"1\") { pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"422\", () => pm.response.to.have.status(422));"
                ]
