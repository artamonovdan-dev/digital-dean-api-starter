      ]
    },
    {
      "name": "Manual file states",
      "description": "Only manual local tests; do not run as part of normal collection run.",
      "item": [
        {
          "name": "05 Missing report local state",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/lab/crypto/asymmetric-benchmark-results"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get(\"manual_state\") !== \"missing\") { pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"safe 404\", () => { pm.response.to.have.status(404); pm.expect(pm.response.json()).to.eql({detail:\"benchmark report not found\"}); });"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Invalid report local state",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/lab/crypto/asymmetric-benchmark-results"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get(\"manual_state\") !== \"invalid\") { pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"safe 500\", () => { pm.response.to.have.status(500); pm.expect(pm.response.json()).to.eql({detail:\"benchmark report invalid\"}); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}